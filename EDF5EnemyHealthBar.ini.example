; ============================================================
; EDF5 敌人血条 MOD —— 配置
; 改完需要重新进入关卡（或重启游戏）生效；热键开关立即生效。
; 颜色一律 RRGGBB 十六进制。
; 任何键都可以删掉——删掉就用代码里的默认值。
; ============================================================

; ---- 总开关 ----
Enabled=1
; 开关热键的 VK 码；0 = 不设热键。例：F8=0x77，F9=0x78
ToggleKey=0x77

; ---- 血条外观（可读性主要靠这三项：底色 / 厚度 / 描边）----
; 血条颜色（血量 > LowHpPercent 时用这个）
BarColor=00FF00
; 宽度（像素）。越短越像"色块"，越长越像"细线"
BarWidth=42
; 高度（像素）。建议 6~10；太细在明亮背景上会被"吃掉"
BarHeight=7
; 1 = 加深色描边，把血条和背景切开；0 = 不描边
BarOutline=1
; 描边厚度（像素），0~4。2 比较稳妥
BarOutlinePx=2
; 背景不透明度 0~255；0 = 不画背景。
; 这是可读性的关键：150 左右时未填充部分是深色，绿/黄/红填充压在上面，什么背景都清楚
BackgroundAlpha=150

; ---- 血量变色 ----
; 血量百分比 <= LowHpPercent 时用 BarColorMid；<= CriticalHpPercent 时用 BarColorLow
BarColorMid=FFFF00
BarColorLow=FF0000
LowHpPercent=60
CriticalHpPercent=20

; ---- 显示条件 ----
; 视野半角（度）。120 = 只要在前方就画
MaxViewAngle=60
; 遮挡检测总开关（被建筑/地形挡住就不画）
OcclusionCheck=1
; 1 = 友军/任何角色单位都不算遮挡，只有地图/建筑/地形才挡血条；0 = 任何命中都算遮挡。
; 若发现血条穿墙，改成 0，并把日志里的 [occl] 挡住 行发出来
OcclusionIgnoreCharacters=1
; 遮挡结果分帧复用：同一对象每 N 帧才重投一次射线（1=每帧都投；2~3 省 1/2~1/3 射线开销）
OcclusionReuse=2
; 命中比例 >= 该值算打到目标自身，不算遮挡（传送塔这类大型建筑型敌人需要 0.90）
OcclusionSelfFrac=0.90
; 遮挡射线采样点数：0 = 自动（大目标 2 点，其余 1 点）；也可以手填 1~3。
; 目的：超大型目标只有一部分露在山丘/建筑外时，只要有一个采样点可见就画血条。
OcclusionSamples=0
; 每个额外采样点在世界上方抬升的基准米数（自动模式会乘体型系数，夹 1~4 倍）
OcclusionSampleStep=12.0
; 自动模式的门槛：最大血量 >= 该值的目标才做多点采样
OcclusionSampleMinHp=1000
; 射线终点往回收的距离（米）。0 = 保持默认（实测判定正常），一般不用改
OcclusionBackoff=0.0
; 射线异常时的策略（异常=游戏物理侧抛访问违例，我们只能吞掉并保守处理）
;   0 = 保守（默认）：异常一次就暂停遮挡射线，切换关卡后自动再试；整场累计 3 次则永久关闭
;   1 = 旧行为：最多重试 3 次才永久关闭（风险更高：可能把游戏数据结构搞坏，之后游戏自己崩）
OcclusionFaultPolicy=0
; 最近 N 秒内掉过血的敌人跳过遮挡判定（你正在打它，就一定看得见）。0 = 关掉
ShowOnDamageSec=3.0
; 最大显示距离（米）；0 = 不限
MaxDistance=0
; 屏幕上的最小身高（像素）；低于这个值就不画。0 = 不限。配合 BarScaleByDistance 用（例如 8）
MinScreenSize=0
; 同屏最多画几条
MaxBars=64

; ---- 尺寸自适应 ----
; 1 = 血条长度随最大血量放大（以普通兵 81 血为基准，sqrt 缩放并夹到 1~3 倍）。
;     好处：大敌人一眼能认出来；代价：同屏"长度"不再直接等价于剩余血量比例
BarWidthByMaxHp=1
; 1 = 血条整体随距离缩小（以 DistanceRef 米为基准，夹到 0.5~1 倍）。
;     和游戏原生 NPC 血条行为一致；太远会变小，建议同时把 MinScreenSize 设成 8 左右
BarScaleByDistance=1
; 距离缩放的参考距离（米）：等于该距离时是 1 倍，两倍距离时是 0.5 倍（再远保持 0.5 倍）
DistanceRef=30.0

; ---- 头顶定位 ----
; 锚点上方额外抬升（米）
HeightOffset=2.0
; 1 = 血量越厚的敌人抬得越高（巨型/Boss 的血条不会埋进身体里）
ScaleHeightByMaxHp=1
; 1 = 优先用游戏自己的锁定点当锚点（更贴合多部位敌人）
UseLockOnPoint=1
; 1 = 把血条屏幕位置夹在视口内（近距离/洞穴里不会顶出画面）
BarScreenClamp=1

; ---- 其它 ----
; 覆盖层重绘上限（fps）。0 = 不限、跟随游戏帧（推荐：转视角不拖影）
DrawFps=0
; 遮挡射线起点：玩家眼睛离地高度（米）
EyeHeight=1.5
; 遮挡射线的 filterInfo。0x16 是游戏自己多处使用的值（另有 0x17）；0 = 打一切（不限层）
RayFilter=0x16
; 覆盖层定位方式：0 = 跟随游戏窗口；1 = 覆盖整个桌面（游戏窗口找不准时用）
OverlayMode=0
; 1 = 往 DLL 同目录写调试日志。日常玩建议 0（关掉）
; 注：游戏失去焦点时本 MOD 会自动停画并隐藏覆盖层，无需配置
Debug=0

; ---- 仅调试用（正常玩别动）----
; 0 = 关；1/2/3 = "原生血条"调研探针（只读，但会明显卡顿）
NativeProbe=0
; 0 = 不画我们自绘的血条（采集照常），用于对照测试；正常玩保持 1
DrawBars=1

; 1 = 分帧扫描"带血量块"的表外目标（如传送塔），只记录不绘制；0 = 关
ExtraObjectScan=0

; ---- 性能统计 ----
; 1 = 输出 [perf] 统计（分阶段耗时 + 覆盖层线程 CPU + 帧间隔）
PerfLog=1
; 统计窗口（毫秒）
PerfIntervalMs=3000
